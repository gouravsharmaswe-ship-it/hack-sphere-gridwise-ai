# Gridwise AI Environment Configuration Template
# Copy this file to .env and populate with your real Zoho Catalyst credentials

# Zoho Catalyst QuickML Inference Endpoint
# Example: https://ml.catalyst.zoho.com/baas/v1/project/<PROJECT_ID>/model/<MODEL_ID>/predict
QUICKML_ENDPOINT_URL=YOUR_PUBLISHED_QUICKML_ENDPOINT_URL_HERE

# Zoho Catalyst OAuth / BaaS API Token (optional depending on endpoint visibility)
QUICKML_API_KEY=

# Inference request timeout in seconds
QUICKML_TIMEOUT_SECONDS=15.0

# Backend Port (FastAPI)
PORT=8000

# Allowed CORS Origins (comma-separated, or * for development)
ALLOWED_ORIGINS=*

# Database path (SQLite file path)
GRIDWISE_DB_PATH=gridwise_history.db
